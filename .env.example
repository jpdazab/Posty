# Copia este archivo a .env.local para desarrollo, o define estas variables en Vercel (ver SETUP.md).
# Sin VITE_SUPABASE_URL ni VITE_SUPABASE_ANON_KEY, Posty funciona en modo local (sin login).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Solo servidor (Vercel). Nunca la pongas en el código ni la compartas.
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: generación con Claude y límite mensual por persona.
ANTHROPIC_API_KEY=
AI_MONTHLY_LIMIT=30
